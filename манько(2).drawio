<mxfile host="app.diagrams.net" agent="ChatGPT" pages="4">
  <diagram name="01_1НФ" id="01_1нф">
    <mxGraphModel dx="2417" dy="930" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="t" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=28;fontStyle=1;fontColor=#172554;" value="1НФ — одна строка на одну позицию заказа" vertex="1">
          <mxGeometry height="55" width="1200" x="50" y="25" as="geometry" />
        </mxCell>
        <mxCell id="a" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf2ff;strokeColor=#5b83bd;fontSize=16;align=left;verticalAlign=top;spacing=12;" value="&lt;b&gt;Позиции заказа (1НФ)&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;PK:&lt;/b&gt; (НомерЗаказа, КодТовара)&lt;br&gt;&lt;br&gt;Заказ | Дата | КодКлиента | Клиент | Телефон | КодТовара | Товар | КодКатегории | Категория | Кол-во&lt;br&gt;&lt;br&gt;201 | 05.10.2026 | K01 | Анна Смирнова | из практической №1 | T01 | Мышь | из практической №1 | из практической №1 | 2&lt;br&gt;201 | 05.10.2026 | K01 | Анна Смирнова | из практической №1 | T02 | Клавиатура | из практической №1 | из практической №1 | 1&lt;br&gt;202 | 06.10.2026 | K02 | Борис Ли | из практической №1 | T03 | SSD 1 ТБ | из практической №1 | из практической №1 | 1&lt;br&gt;203 | 06.10.2026 | K01 | Анна Смирнова | из практической №1 | T03 | SSD 1 ТБ | из практической №1 | из практической №1 | 1&lt;br&gt;203 | 06.10.2026 | K01 | Анна Смирнова | из практической №1 | T01 | Мышь | из практической №1 | из практической №1 | 1&lt;br&gt;204 | 07.10.2026 | K03 | Дарья Петрова | из практической №1 | T02 | Клавиатура | из практической №1 | из практической №1 | 1&lt;br&gt;204 | 07.10.2026 | K03 | Дарья Петрова | из практической №1 | T04 | USB-хаб | из практической №1 | из практической №1 | 1" vertex="1">
          <mxGeometry height="600" width="1200" x="50" y="115" as="geometry" />
        </mxCell>
        <mxCell id="b" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff7df;strokeColor=#d6b85a;fontSize=16;align=left;verticalAlign=middle;spacing=12;" value="&lt;b&gt;Почему составной PK?&lt;/b&gt;&lt;br&gt;Номер заказа повторяется для разных товаров, а товар встречается в разных заказах. Пара (НомерЗаказа, КодТовара) уникальна во всех 7 строках. Телефоны, коды и названия категорий следует перенести из вашей практической №1 — на скриншотах этих справочных данных нет." vertex="1">
          <mxGeometry height="130" width="1200" x="50" y="750" as="geometry" />
        </mxCell>
        <mxCell id="Hl1CGOCZlsDdRipAZUmW-1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="Манько ИС25-9-3" vertex="1">
          <mxGeometry height="60" width="190" x="1340" y="20" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="02_2НФ" id="02_2нф">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="t" value="2НФ — убрать частичные зависимости от составного ключа" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=28;fontStyle=1;fontColor=#172554;" parent="1" vertex="1">
          <mxGeometry x="50" y="25" width="1200" height="55" as="geometry" />
        </mxCell>
        <mxCell id="a" value="&lt;b&gt;Заказы&lt;/b&gt;&lt;br&gt;&lt;b&gt;PK:&lt;/b&gt; НомерЗаказа&lt;br&gt;Дата, КодКлиента (FK → Клиенты)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e7f6ec;strokeColor=#4b9b68;fontSize=16;align=left;verticalAlign=top;spacing=12;" parent="1" vertex="1">
          <mxGeometry x="50" y="130" width="340" height="150" as="geometry" />
        </mxCell>
        <mxCell id="b" value="&lt;b&gt;Клиенты&lt;/b&gt;&lt;br&gt;&lt;b&gt;PK:&lt;/b&gt; КодКлиента&lt;br&gt;ИмяКлиента, Телефон" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e7f6ec;strokeColor=#4b9b68;fontSize=16;align=left;verticalAlign=top;spacing=12;" parent="1" vertex="1">
          <mxGeometry x="480" y="130" width="340" height="150" as="geometry" />
        </mxCell>
        <mxCell id="c" value="&lt;b&gt;Товары&lt;/b&gt;&lt;br&gt;&lt;b&gt;PK:&lt;/b&gt; КодТовара&lt;br&gt;НазваниеТовара, КодКатегории (FK)&lt;br&gt;&lt;br&gt;T01 — Мышь&lt;br&gt;T02 — Клавиатура&lt;br&gt;T03 — SSD 1 ТБ&lt;br&gt;T04 — USB-хаб" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e7f6ec;strokeColor=#4b9b68;fontSize=16;align=left;verticalAlign=top;spacing=12;" parent="1" vertex="1">
          <mxGeometry x="910" y="130" width="340" height="180" as="geometry" />
        </mxCell>
        <mxCell id="d" value="&lt;b&gt;ПозицииЗаказа&lt;/b&gt;&lt;br&gt;&lt;b&gt;PK:&lt;/b&gt; (НомерЗаказа, КодТовара)&lt;br&gt;&lt;b&gt;FK:&lt;/b&gt; НомерЗаказа → Заказы&lt;br&gt;&lt;b&gt;FK:&lt;/b&gt; КодТовара → Товары&lt;br&gt;Количество" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf2ff;strokeColor=#5b83bd;fontSize=16;align=left;verticalAlign=top;spacing=12;" parent="1" vertex="1">
          <mxGeometry x="480" y="440" width="340" height="190" as="geometry" />
        </mxCell>
        <mxCell id="e" value="&lt;b&gt;Частичные зависимости устранены&lt;/b&gt;&lt;br&gt;Дата и клиент зависят только от НомерЗаказа. Название товара и категория зависят только от КодТовара. Количество зависит от пары (НомерЗаказа, КодТовара)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff7df;strokeColor=#d6b85a;fontSize=16;align=left;verticalAlign=middle;spacing=12;" parent="1" vertex="1">
          <mxGeometry x="50" y="720" width="1200" height="130" as="geometry" />
        </mxCell>
        <mxCell id="100" value="1:N" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=14;labelBackgroundColor=#ffffff;" parent="1" edge="1" source="a" target="d">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="101" value="1:N" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=14;labelBackgroundColor=#ffffff;" parent="1" edge="1" source="c" target="d">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="102" value="1:N" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=14;labelBackgroundColor=#ffffff;" parent="1" edge="1" source="b" target="a">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="03_3НФ" id="03_3нф">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="t" value="3НФ — вынести транзитивно зависимые описания" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=28;fontStyle=1;fontColor=#172554;" parent="1" vertex="1">
          <mxGeometry x="50" y="25" width="1200" height="55" as="geometry" />
        </mxCell>
        <mxCell id="a" value="&lt;b&gt;Клиенты&lt;/b&gt;&lt;br&gt;&lt;b&gt;PK:&lt;/b&gt; КодКлиента&lt;br&gt;ИмяКлиента&lt;br&gt;Телефон" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e7f6ec;strokeColor=#4b9b68;fontSize=16;align=left;verticalAlign=top;spacing=12;" parent="1" vertex="1">
          <mxGeometry x="40" y="145" width="260" height="145" as="geometry" />
        </mxCell>
        <mxCell id="b" value="&lt;b&gt;Заказы&lt;/b&gt;&lt;br&gt;&lt;b&gt;PK:&lt;/b&gt; НомерЗаказа&lt;br&gt;Дата&lt;br&gt;&lt;b&gt;FK:&lt;/b&gt; КодКлиента" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf2ff;strokeColor=#5b83bd;fontSize=16;align=left;verticalAlign=top;spacing=12;" parent="1" vertex="1">
          <mxGeometry x="365" y="145" width="260" height="145" as="geometry" />
        </mxCell>
        <mxCell id="c" value="&lt;b&gt;ПозицииЗаказа&lt;/b&gt;&lt;br&gt;&lt;b&gt;PK:&lt;/b&gt; (НомерЗаказа, КодТовара)&lt;br&gt;&lt;b&gt;FK:&lt;/b&gt; НомерЗаказа&lt;br&gt;&lt;b&gt;FK:&lt;/b&gt; КодТовара&lt;br&gt;Количество" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf2ff;strokeColor=#5b83bd;fontSize=16;align=left;verticalAlign=top;spacing=12;" parent="1" vertex="1">
          <mxGeometry x="690" y="390" width="300" height="180" as="geometry" />
        </mxCell>
        <mxCell id="d" value="&lt;b&gt;Товары&lt;/b&gt;&lt;br&gt;&lt;b&gt;PK:&lt;/b&gt; КодТовара&lt;br&gt;НазваниеТовара&lt;br&gt;&lt;b&gt;FK:&lt;/b&gt; КодКатегории" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e7f6ec;strokeColor=#4b9b68;fontSize=16;align=left;verticalAlign=top;spacing=12;" parent="1" vertex="1">
          <mxGeometry x="690" y="145" width="300" height="145" as="geometry" />
        </mxCell>
        <mxCell id="e" value="&lt;b&gt;Категории&lt;/b&gt;&lt;br&gt;&lt;b&gt;PK:&lt;/b&gt; КодКатегории&lt;br&gt;НазваниеКатегории" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e7f6ec;strokeColor=#4b9b68;fontSize=16;align=left;verticalAlign=top;spacing=12;" parent="1" vertex="1">
          <mxGeometry x="1060" y="145" width="280" height="145" as="geometry" />
        </mxCell>
        <mxCell id="f" value="&lt;b&gt;Почему это 3НФ?&lt;/b&gt;&lt;br&gt;Клиентские данные хранятся отдельно от заказа. Название категории хранится один раз в таблице Категории, а товар ссылается на неё по FK. В таблице позиций остаётся только количество, относящееся к конкретной паре заказа и товара." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff7df;strokeColor=#d6b85a;fontSize=16;align=left;verticalAlign=middle;spacing=12;" parent="1" vertex="1">
          <mxGeometry x="40" y="700" width="1300" height="150" as="geometry" />
        </mxCell>
        <mxCell id="100" value="1:N" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=14;labelBackgroundColor=#ffffff;" parent="1" edge="1" source="a" target="b">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="101" value="1:N" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=14;labelBackgroundColor=#ffffff;" parent="1" edge="1" source="b" target="c">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="102" value="1:N" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=14;labelBackgroundColor=#ffffff;" parent="1" edge="1" source="d" target="c">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="103" value="1:N" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=14;labelBackgroundColor=#ffffff;" parent="1" edge="1" source="e" target="d">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="04_Проверка" id="04_проверка">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="t" value="Проверка модели 3НФ — три сценария" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=28;fontStyle=1;fontColor=#172554;" parent="1" vertex="1">
          <mxGeometry x="50" y="25" width="1250" height="55" as="geometry" />
        </mxCell>
        <mxCell id="a" value="&lt;b&gt;1. Добавить клиента K04 без заказов&lt;/b&gt;&lt;br&gt;Добавить одну запись только в &lt;b&gt;Клиенты&lt;/b&gt;: K04, Глеб Орлов, +7-900-111-11-04. Заказ не требуется, потому что клиент не зависит от заказа." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff7df;strokeColor=#d6b85a;fontSize=16;align=left;verticalAlign=middle;spacing=12;" parent="1" vertex="1">
          <mxGeometry x="50" y="130" width="1200" height="150" as="geometry" />
        </mxCell>
        <mxCell id="b" value="&lt;b&gt;2. Изменить телефон клиента K01&lt;/b&gt;&lt;br&gt;Обновить телефон в одной строке таблицы &lt;b&gt;Клиенты&lt;/b&gt; для K01. Заказы и позиции не меняются: они ссылаются на КодКлиента." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff7df;strokeColor=#d6b85a;fontSize=16;align=left;verticalAlign=middle;spacing=12;" parent="1" vertex="1">
          <mxGeometry x="50" y="330" width="1200" height="150" as="geometry" />
        </mxCell>
        <mxCell id="c" value="&lt;b&gt;3. Добавить товар T05 в существующую категорию&lt;/b&gt;&lt;br&gt;Добавить строку в &lt;b&gt;Товары&lt;/b&gt; с КодТовара=T05 и FK КодКатегории=C02. Новую категорию создавать не нужно. Строка в ПозицииЗаказа появляется только если товар включён в конкретный заказ." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff7df;strokeColor=#d6b85a;fontSize=16;align=left;verticalAlign=middle;spacing=12;" parent="1" vertex="1">
          <mxGeometry x="50" y="530" width="1200" height="170" as="geometry" />
        </mxCell>
        <mxCell id="d" value="&lt;b&gt;Ожидаемые ограничения&lt;/b&gt;&lt;br&gt;PK: Клиенты(KодКлиента), Заказы(НомерЗаказа), Товары(КодТовара), Категории(КодКатегории), ПозицииЗаказа(НомерЗаказа, КодТовара). FK должны ссылаться на существующие записи; повтор пары заказа и товара запрещён." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf2ff;strokeColor=#5b83bd;fontSize=16;align=left;verticalAlign=top;spacing=12;" parent="1" vertex="1">
          <mxGeometry x="50" y="750" width="1200" height="120" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
